{
  "compatibility_date": "2025-04-01",
  "main": "src/server/index.ts",
  "name": "shantry-chat-app-from-cloudflare",
  "migrations": [
    {
      "new_sqlite_classes": ["Chat"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["RoomDirectory"],
      "tag": "v2"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "build": {
    "command": "esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Chat",
        "name": "Chat"
      },
      {
        "class_name": "RoomDirectory",
        "name": "RoomDirectory"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
